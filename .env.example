# ---------------------------------------------------------------------------
# Ranaha Gold Company — Frontend Deployment Environment Variables
#
# Copy this file to `.env.local` and replace the placeholders.
# `.env.local` is git-ignored and must never be committed.
#
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   macOS / Linux:         cp .env.example .env.local
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — required for enquiry forms, career applications, and middleware
# Find these in the Supabase dashboard: Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key (safe to expose to the browser; access limited by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER-ONLY. Bypasses Row Level Security.
# Required by enquiry and career API routes.
# Never expose to the browser, never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Live metal rates — optional
# The rates route uses a keyless public API plus a static fallback.
# ---------------------------------------------------------------------------

# Optional GoldAPI.io key (second-tier fallback provider)
# GOLD_API_KEY=your-goldapi-key

# Server-side cache lifetime for metal rates, in seconds. Default: 300.
METALS_CACHE_TTL=300

# ---------------------------------------------------------------------------
# Public site metadata — optional
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ranahagold.com
